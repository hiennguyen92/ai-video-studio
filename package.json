{
  "name": "ai-video-studio",
  "version": "0.1.0",
  "description": "AI Video Studio \u2014 tr\u00ecnh ch\u1ec9nh s\u1eeda video desktop v\u1edbi timeline nhi\u1ec1u track v\u00e0 b\u1ed9 c\u00f4ng c\u1ee5 AI (phi\u00ean \u00e2m, d\u1ecbch, l\u1ed3ng ti\u1ebfng, ph\u1ee5 \u0111\u1ec1).",
  "main": "./out/main/index.js",
  "author": "AI Video Studio",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/bundle-remotion.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test:e2e": "npm run build && playwright test",
    "smoke:packaged": "node scripts/smoke-packaged-app.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@remotion/bundler": "^4.0.522",
    "@remotion/player": "^4.0.522",
    "@remotion/renderer": "^4.0.522",
    "ffmpeg-static": "^5.3.0",
    "remotion": "^4.0.522",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "immer": "^10.1.1",
    "nanoid": "^5.0.9",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-resizable-panels": "^2.1.7",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "ffmpeg-static@5.3.0": true,
    "@ffprobe-installer/darwin-arm64@5.0.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  }
}
